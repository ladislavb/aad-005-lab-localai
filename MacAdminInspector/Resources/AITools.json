{
  "cliSearchDirectories": [
    "/opt/homebrew/bin",
    "/usr/local/bin",
    "~/.local/bin",
    "~/.npm-global/bin"
  ],
  "tools": [
    {
      "id": "chatgpt",
      "name": "ChatGPT",
      "category": "assistant",
      "gui": {
        "bundleIdentifiers": [
          "com.openai.chat",
          "com.openai.codex"
        ]
      },
      "cli": {
        "executables": ["codex"],
        "versionArguments": ["--version"]
      },
      "configSearch": {
        "paths": ["~/.codex"],
        "recursive": true,
        "includePatterns": ["*.toml", "*.json", "*.jsonc"],
        "excludePatterns": ["auth.json", "credentials.json", "keys.json", "secrets.yaml", ".env", ".env.*"]
      }
    },
    {
      "id": "claude",
      "name": "Claude",
      "category": "assistant",
      "gui": {
        "bundleIdentifiers": ["com.anthropic.claudefordesktop"]
      },
      "cli": {
        "executables": ["claude"],
        "versionArguments": ["--version"]
      },
      "configSearch": {
        "paths": ["~/.claude"],
        "recursive": true,
        "includePatterns": ["*.json"],
        "excludePatterns": []
      }
    },
    {
      "id": "gemini-cli",
      "name": "Gemini CLI",
      "category": "codingAgent",
      "cli": {
        "executables": ["gemini"],
        "versionArguments": ["--version"]
      },
      "configSearch": {
        "paths": ["~/.gemini"],
        "recursive": true,
        "includePatterns": ["*.json"],
        "excludePatterns": []
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "category": "codingAgent",
      "cli": {
        "executables": ["opencode"],
        "searchDirectories": ["~/.opencode/bin"],
        "versionArguments": ["--version"]
      },
      "configSearch": {
        "paths": ["~/.config/opencode"],
        "recursive": true,
        "includePatterns": ["*.json", "*.jsonc"],
        "excludePatterns": []
      }
    }
  ]
}
